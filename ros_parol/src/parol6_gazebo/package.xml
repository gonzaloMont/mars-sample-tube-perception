<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>parol6_gazebo</name>
  <version>0.0.0</version>
  <description>Gazebo simulation worlds, models, controller config, and launch files for PAROL6.</description>
  <maintainer email="montanagonzalo73@gmail.com">gonzalomontanagomez</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <!-- Workspace packages -->
  <exec_depend>parol6_description</exec_depend>
  <exec_depend>parol6_moveit</exec_depend>
  <exec_depend>parol6_controllers</exec_depend>

  <!-- Gazebo -->
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>gazebo_ros2_control</exec_depend>

  <!-- ros2_control -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>

  <!-- Nodes launched directly from launch files -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- MoveIt -->
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
