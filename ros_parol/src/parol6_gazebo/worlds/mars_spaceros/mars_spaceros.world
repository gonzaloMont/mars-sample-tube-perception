<?xml version="1.0" ?>
<!--
  Mundo marciano NUEVO migrado desde Space ROS (Gazebo Ignition/Harmonic) a
  Gazebo Classic 11.

  Origen del terreno:
    spaceros_gz_demos/models/martian_surface  (malla martian_surface.glb,
    "Martian surface" de Kubocarte en Sketchfab, usada en worlds/mars.sdf de
    Space ROS).

  Adaptaciones Ignition -> Gazebo Classic 11 aplicadas:
    * <sdf version="1.9"> (Ignition)  ->  <sdf version="1.7"> (Classic).
    * Eliminados los plugins de sistema de Ignition (gz-sim-physics-system,
      gz-sim-sensors-system, gz-sim-scene-broadcaster-system, etc.) y todos los
      plugins de GUI de gz-gui (MinimalScene, WorldControl, WorldStats...).
    * Eliminadas las inclusiones del rover/helicóptero (nasa_perseverance,
      nasa_ingenuity) y su plugin DiffDrive de Ignition: este mundo es solo el
      entorno para el brazo PAROL6.
    * La malla .glb (no soportada por Classic) se ha convertido a .obj + .mtl +
      textura (Material.png) con escala x100 y rotación Y-up -> Z-up HORNEADAS en
      los vértices, recentrada para que el suelo quede en z≈0 sobre el origen y
      RECORTADA a +-15 m (el .glb completo son 200x200 m / ~520k tri / 50 MB,
      demasiado para una iGPU con cámaras estéreo; recortar preserva la textura
      y baja a ~12k tri, el mismo peso que worlds/mars_bumpy).
    * <uri> ahora apuntan a las mallas locales por ruta relativa al .world
      (mismo criterio que worlds/mars y worlds/mars_optimized).
    * Añadidos los elementos típicos de Classic: <physics> ODE, luz direccional
      "sun" (sin sombras), <scene> con cielo marciano y libgazebo_ros_state.so.

  Convención de mallas: visual = malla recortada texturizada (~12k tri);
  colisión = malla recortada y decimada (~6k tri) para no penalizar el solver ODE.

  Textura del terreno realzada para el estéreo: la textura original del .glb es
  lisa y de bajo contraste (el matcher solo encontraba correspondencias en el
  brazo, no en el suelo). Se ha re-teselado (UV x4 sobre el parche recortado) y
  realzado con contraste + detalle multi-octava de alta frecuencia (regolito
  rocoso) a 2048x2048. Ver convert_from_spaceros.py (UV_TILING, TEX_CONTRAST,
  TEX_DETAIL). Tras regenerar, material.mtl queda con Kd 0.4 0.4 0.4 (default de
  trimesh): hay que volver a ponerlo a Kd 1 1 1 / illum 1 (estilo
  worlds/mars_optimized/mars_patch.mtl).

  Regenerar (ajustar CROP_RADIUS): python3 convert_from_spaceros.py
-->
<sdf version="1.7">
  <world name="default">

    <!-- Cámara inicial de la GUI (enmarca el área de trabajo del robot en el origen) -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>3.0 -3.0 1.8 0 0.32 2.3562</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- Gravedad marciana -->
    <gravity>0 0 -3.71</gravity>

    <!-- ================= FÍSICA (ODE) ================= -->
    <!-- 250 Hz / paso 0.004 con solver 'quick', igual que worlds/mars_optimized.
         La máquina lleva una iGPU Intel modesta y las cámaras estéreo ya consumen
         mucho; 500 Hz hundía el RTF. Para tests por lotes más rápidos que el tiempo
         real, pon real_time_update_rate = 0. -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_update_rate>250</real_time_update_rate>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ================= ESCENA (cielo marciano) ================= -->
    <!-- Sombras DESACTIVADAS a propósito (igual que worlds/mars y mars_optimized):
         con una malla de terreno grande, el shadow-mapping de Gazebo Classic produce
         auto-sombreado ("shadow acne") que oscurece toda la escena, sobre todo al
         hacer zoom. Sin sombras se ve uniforme y bien iluminado. -->
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.82 0.56 0.42 1</background>  <!-- tono polvoriento anaranjado -->
      <shadows>0</shadows>
      <grid>0</grid>
    </scene>

    <!-- Luz direccional cálida tipo sol marciano (sin proyectar sombras) -->
    <light name="sun" type="directional">
      <cast_shadows>0</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.9 0.85 0.8 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.5 0.3 -0.8</direction>
    </light>

    <!-- ================= TERRENO MARCIANO (Space ROS martian_surface) ================= -->
    <!-- Parche de ~30 x 30 m (recortado a +-15 m), centrado en el origen; el suelo
         en el origen está a z≈0, de modo que el brazo PAROL6 (generado en 0,0,0)
         queda sobre la superficie. -->
    <model name="martian_surface">
      <static>1</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="terrain">
        <!-- Visual: malla recortada texturizada (~12k tri) -->
        <visual name="visual">
          <geometry>
            <mesh><uri>martian_surface.obj</uri></mesh>
          </geometry>
        </visual>
        <!-- Colisión: malla decimada (mismo relieve, mucho más ligera para ODE).
             El brazo va fijo al world, así que la colisión solo afecta a los
             objetos dinámicos (tubos, etc.), que se apoyan en el relieve real. -->
        <collision name="collision">
          <geometry>
            <mesh><uri>martian_surface_collision.obj</uri></mesh>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>1e2</kd></ode></contact>
          </surface>
        </collision>
      </link>
    </model>

    <!-- Plugin de estado de Gazebo-ROS: expone /get_entity_state y /set_entity_state
         (igual que en worlds/mars y worlds/mars_optimized). -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/</namespace></ros>
      <update_rate>10</update_rate>
    </plugin>

  </world>
</sdf>
