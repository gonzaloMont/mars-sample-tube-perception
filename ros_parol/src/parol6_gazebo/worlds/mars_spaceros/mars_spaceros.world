<?xml version="1.0" ?>
<!--
  Mundo marciano NUEVO migrado desde Space ROS (Gazebo Ignition/Harmonic) a
  Gazebo Classic 11.

  Origen del terreno:
    spaceros_gz_demos/models/martian_surface  (malla martian_surface.glb,
    "Martian surface" de Kubocarte en Sketchfab, usada en worlds/mars.sdf de
    Space ROS).

  Adaptaciones Ignition -> Gazebo Classic 11 aplicadas:
    * <sdf version="1.9"> (Ignition)  ->  <sdf version="1.7"> (Classic).
    * Eliminados los plugins de sistema de Ignition (gz-sim-physics-system,
      gz-sim-sensors-system, gz-sim-scene-broadcaster-system, etc.) y todos los
      plugins de GUI de gz-gui (MinimalScene, WorldControl, WorldStats...).
    * Eliminadas las inclusiones del rover/helicóptero (nasa_perseverance,
      nasa_ingenuity) y su plugin DiffDrive de Ignition: este mundo es solo el
      entorno para el brazo PAROL6.
    * La malla .glb (no soportada por Classic) se ha convertido a .obj + .mtl +
      textura (Material.png) con escala x100 y rotación Y-up -> Z-up HORNEADAS en
      los vértices, y recentrada para que el suelo quede en z≈0 sobre el origen.
    * <uri> ahora apuntan a las mallas locales por ruta relativa al .world
      (mismo criterio que worlds/mars y worlds/mars_optimized).
    * Añadidos los elementos típicos de Classic: <physics> ODE, luz direccional
      "sun", <scene> con cielo marciano y el plugin libgazebo_ros_state.so.

  Convención de mallas: visual = malla completa texturizada (~520k tri);
  colisión = malla decimada (~40k tri) para no penalizar el solver ODE.
  Regenerar: python3 (ver docs) a partir del .glb de Space ROS.
-->
<sdf version="1.7">
  <world name="default">

    <!-- Cámara inicial de la GUI (enmarca el área de trabajo del robot en el origen) -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>3.0 -3.0 1.8 0 0.32 2.3562</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- Gravedad marciana -->
    <gravity>0 0 -3.71</gravity>

    <!-- ================= FÍSICA (ODE, equilibrio fidelidad/RTF) ================= -->
    <!-- 500 Hz con solver 'quick': suficiente para la colisión de terreno (~40k tri)
         y los objetos manipulables. Para tests por lotes más rápidos que el tiempo
         real, pon real_time_update_rate = 0. -->
    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_update_rate>500</real_time_update_rate>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ================= ESCENA (cielo marciano) ================= -->
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.82 0.56 0.42 1</background>  <!-- tono polvoriento anaranjado -->
      <shadows>1</shadows>
      <grid>0</grid>
    </scene>

    <!-- Luz direccional cálida tipo sol marciano -->
    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.9 0.85 0.8 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.5 0.3 -0.8</direction>
    </light>

    <!-- ================= TERRENO MARCIANO (Space ROS martian_surface) ================= -->
    <!-- ~200 x 200 m, centrado en el origen; el suelo en el origen está a z≈0,
         de modo que el brazo PAROL6 (generado en 0,0,0) queda sobre la superficie. -->
    <model name="martian_surface">
      <static>1</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="terrain">
        <!-- Visual: malla completa texturizada -->
        <visual name="visual">
          <geometry>
            <mesh><uri>martian_surface.obj</uri></mesh>
          </geometry>
        </visual>
        <!-- Colisión: malla decimada (mismo relieve, mucho más ligera para ODE).
             El brazo va fijo al world, así que la colisión solo afecta a los
             objetos dinámicos (tubos, etc.), que se apoyan en el relieve real. -->
        <collision name="collision">
          <geometry>
            <mesh><uri>martian_surface_collision.obj</uri></mesh>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>1e2</kd></ode></contact>
          </surface>
        </collision>
      </link>
    </model>

    <!-- Plugin de estado de Gazebo-ROS: expone /get_entity_state y /set_entity_state
         (igual que en worlds/mars y worlds/mars_optimized). -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/</namespace></ros>
      <update_rate>10</update_rate>
    </plugin>

  </world>
</sdf>
