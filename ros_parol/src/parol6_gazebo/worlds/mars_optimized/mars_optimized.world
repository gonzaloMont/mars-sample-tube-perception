<?xml version="1.0" ?>
<!--
  Mundo marciano ULTRA-OPTIMIZADO para pruebas de visión (Gazebo Classic 11).

  Generado a partir de worlds/mars/mars.world recortando el terreno a la región
  inmediata del robot. Decisiones de optimización:
    * Terreno: malla real RECORTADA a +-6 m (mars_patch.obj, ~8.5k tri = 10.5 %
      del original) usada como visual Y colisión. Texturas 14 MB -> ~0.4 MB.
    * Colisión: la misma malla recortada (~8.5k tri, -90 % frente a los 81 200
      del original) -> los objetos se apoyan en el relieve marciano REAL.
    * Sin sombras (escena y luz) -> gran ahorro de GPU.
    * Física ODE 'quick' a 250 Hz (paso 0.004) en vez de 1000 Hz.
    * Sin <state>/<wind>/<spherical_coordinates>/<atmosphere> innecesarios.
  Regenerar el parche: python3 generate_mars_patch.py --radius 6
-->
<sdf version="1.6">
  <world name="default">

    <!-- Cámara inicial de la GUI (enmarca el área de trabajo del robot) -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>1.28444 -1.29501 0.573552 0 0.275643 2.35619</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- Gravedad marciana -->
    <gravity>0 0 -3.71</gravity>

    <!-- ================= FÍSICA (optimizada para RTF) ================= -->
    <!-- 250 Hz fija el RTF a ~1.0 y deja CPU libre. Para correr MÁS rápido que
         el tiempo real (tests por lotes) pon real_time_update_rate = 0. -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_update_rate>250</real_time_update_rate>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ================= ESCENA (sin sombras) ================= -->
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.86 0.60 0.45 1</background>  <!-- tono cielo marciano -->
      <shadows>0</shadows>
      <grid>0</grid>
    </scene>

    <!-- Luz direccional, sin sombras proyectadas -->
    <light name="sun" type="directional">
      <cast_shadows>0</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.85 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ================= TERRENO RECORTADO (solo visual) ================= -->
    <model name="mars_terrain">
      <static>1</static>
      <link name="body">
        <visual name="visual">
          <cast_shadows>0</cast_shadows>
          <geometry>
            <mesh><uri>mars_patch.obj</uri></mesh>
          </geometry>
        </visual>
        <!-- Colisión con el relieve marciano REAL (~8.5k tri, -90 % vs original).
             Los objetos manipulables se apoyan sobre la superficie del terreno,
             no sobre un plano. El brazo va fijo al world, así que esto solo
             afecta a los objetos dinámicos. -->
        <collision name="collision">
          <geometry>
            <mesh><uri>mars_patch.obj</uri></mesh>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>1e2</kd></ode></contact>
          </surface>
        </collision>
      </link>
    </model>

    <!-- Plugin de estado: expone /get_entity_state y /set_entity_state -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/</namespace></ros>
      <update_rate>10</update_rate>
    </plugin>

  </world>
</sdf>
