<?xml version="1.0" ?>
<!--
  Mundo marciano con MONTAÑITAS SINUSOIDALES (egg-crate) para pruebas de visión.

  Objetivo: que un tubo fino (r~1 cm) colocado en distintas poses (tip/tilt/yaw)
  quede atrapado entre los bultos y NO salga rodando, conservando una pose
  estable que se lee por ground-truth (/get_entity_state).

  Terreno: malla procedural z = A*(sin(2pi x/λ)+sin(2pi y/λ)), λ=10 cm, A=1 cm
           (barrera de rodadura ~20 mm pico-valle), parche
           1.2x1.2 m, ~12.8k tri, usada como VISUAL Y COLISIÓN. Textura Mars.
  Fondo:   suelo plano marciano 6x6 m (mars_ground.obj, textura 3x3) que rellena
           el campo de visión de la cámara; las montañitas finas solo van en el
           centro donde se coloca el tubo.
           Regenerar: python3 generate_bumpy_patch.py
  Optimización: sin sombras, ODE 'quick', sin <state>/<wind>/etc.
  Nota: física a 333 Hz (paso 0.003) para que el tubo ligero asiente estable
        sobre los contactos rígidos del relieve. Si priorizas RTF sobre
        estabilidad, sube max_step_size a 0.004.
-->
<sdf version="1.6">
  <world name="default">

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0.9 -0.9 0.7 0 0.45 2.35619</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <gravity>0 0 -3.71</gravity>

    <!-- ================= FÍSICA (estable para objeto ligero) ================= -->
    <physics type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_update_rate>333</real_time_update_rate>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ================= ESCENA (sin sombras) ================= -->
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.86 0.60 0.45 1</background>
      <shadows>0</shadows>
      <grid>0</grid>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>0</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.85 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ============ SUELO MARS DE FONDO (rellena el campo de visión) ============ -->
    <!-- Quad plano con textura Mars (6x6 m, 3x3 tiles) a z=-0.021, justo bajo los
         valles del parche, para que TODO lo que ve la cámara sea marciano. Las
         montañitas de 1 cm son casi invisibles a esta distancia, así que el fondo
         plano es indistinguible y casi gratis. Colisión de PLANO de seguridad. -->
    <model name="mars_ground">
      <static>1</static>
      <pose>0 0 -0.021 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <cast_shadows>0</cast_shadows>
          <geometry><mesh><uri>mars_ground.obj</uri></mesh></geometry>
        </visual>
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>6 6</size></plane></geometry>
          <surface>
            <friction><ode><mu>100</mu><mu2>100</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>1e2</kd></ode></contact>
          </surface>
        </collision>
      </link>
    </model>

    <!-- ================= TERRENO EGG-CRATE (visual + colisión) ================= -->
    <model name="mars_bumpy_terrain">
      <static>1</static>
      <link name="body">
        <visual name="visual">
          <cast_shadows>0</cast_shadows>
          <geometry>
            <mesh><uri>mars_bumpy.obj</uri></mesh>
          </geometry>
        </visual>
        <collision name="collision">
          <geometry>
            <mesh><uri>mars_bumpy.obj</uri></mesh>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <friction><ode><mu>100</mu><mu2>100</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>1e2</kd><min_depth>0.0</min_depth><max_vel>0.1</max_vel></ode></contact>
          </surface>
        </collision>
      </link>
    </model>

    <!-- Plugin de estado: expone /get_entity_state y /set_entity_state -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/</namespace></ros>
      <update_rate>10</update_rate>
    </plugin>

  </world>
</sdf>
