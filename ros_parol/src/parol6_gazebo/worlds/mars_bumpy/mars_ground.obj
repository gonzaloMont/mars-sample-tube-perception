# Suelo Mars de fondo (quad plano texturizado, generado)
mtllib mars_bumpy.mtl
o mars_ground
v -3.0000 -3.0000 0.0
v 3.0000 -3.0000 0.0
v 3.0000 3.0000 0.0
v -3.0000 3.0000 0.0
vt 0.0000 0.0000
vt 3.0000 0.0000
vt 3.0000 3.0000
vt 0.0000 3.0000
vn 0 0 1
usemtl mars
s off
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
