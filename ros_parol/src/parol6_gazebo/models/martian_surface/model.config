<?xml version="1.0"?>
<model>
  <name>martian_surface</name>
  <version>2.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author>
    <name>Kubocarte (Sketchfab); SpaceROS team; TFM adaptation (GLB→OBJ conversion)</name>
  </author>
  <description>
    Martian surface terrain (~199x199 m, ~30 m height variation) for Gazebo Classic.
    Converted from GLB (GLTF2) to OBJ (Wavefront) because Gazebo Classic uses OGRE 1.x
    which does not natively support GLB/GLTF2. The conversion preserves geometry,
    UV mapping, and albedo texture. Axis orientation corrected: GLTF Y-up to Gazebo Z-up.
  </description>
</model>
