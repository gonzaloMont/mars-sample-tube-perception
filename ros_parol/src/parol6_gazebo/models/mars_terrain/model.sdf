
<?xml version="1.0" ?>
<sdf version="1.6">
    <model name="mars_terrain_sol667">
        <static>true</static>
        <link name="terrain">
        <!-- Visual: entorno completo baja resolución -->
        <visual name="terrain_visual">
            <geometry><mesh>
            <uri>model://mars_terrain/meshes/terrain_env_lowres.obj</uri>
            </mesh></geometry>
        </visual>
        <!-- Colisión: ROI de grasping alta resolución -->
        <collision name="terrain_collision">
            <geometry><mesh>
            <uri>model://mars_terrain/meshes/terrain_roi_grasping_fixed.obj</uri>
            </mesh></geometry>
            <surface><friction><ode>
            <mu>0.8</mu><mu2>0.8</mu2>
            </ode></friction><contact><ode>
            <kp>1e6</kp><kd>1.0</kd>
            </ode></contact></surface>
        </collision>
        </link>
    </model>
</sdf>
