<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">

    <!-- quitar sombras, necesario para el mac por recursos -->
    <scene> 
      <ambient>0.4 0.4 0.4 1</ambient> 
      <background>0.7 0.7 0.7 1</background> 
      <shadows>false</shadows>
    </scene>

    <!-- Luz y suelo estándar -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Plugin que expone /get_entity_state y /set_entity_state -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>10</update_rate>
    </plugin>

  </world>
</sdf>
