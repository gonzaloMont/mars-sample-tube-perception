<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">

    <!-- Luz y suelo estándar -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Plugin que expone /get_entity_state y /set_entity_state -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>10</update_rate>
    </plugin>

  </world>
</sdf>
