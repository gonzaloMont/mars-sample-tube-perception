<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>parol6_vision</name>
  <version>0.1.0</version>
  <description>
    Vision pipeline for the PAROL6 robot. It reads overhead camera images,
    detects objects with YOLO, and estimates target 6D poses for the arm
    using LINEMOD template matching.
  </description>
  <maintainer email="montanagonzalo73@gmail.com">gonzalomontanagomez</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- ROS 2 infrastructure -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>message_filters</exec_depend>

  <!-- Messages -->
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>

  <!-- Vision -->
  <exec_depend>cv_bridge</exec_depend>
  <!-- OpenCV con módulos CONTRIB (obligatorio):
         * cv2.ximgproc  -> stereo_pointcloud_node.py (WLS + RightMatcher)
         * cv2.linemod   -> LINEMOD (ver README_LINEMOD.md)
       El paquete apt `python3-opencv` SÍ los trae (depende de
       libopencv-contrib). AVISO: si hay un `opencv-python` instalado por pip
       (p.ej. en ~/.local, arrastrado por ultralytics) ECLIPSA al de apt y NO
       trae contrib -> `cv2.ximgproc` desaparece y el nodo estéreo aborta.
       En ese caso, sustituirlo por la rueda contrib (misma versión):
         pip uninstall -y opencv-python && \
         pip install opencv-contrib-python==<misma_version>
       Ver requirements.txt de este paquete. -->
  <exec_depend>python3-opencv</exec_depend>

  <!-- YOLO -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-ultralytics</exec_depend>

  <!-- LINEMOD: render offline de templates y carga de mallas.
       trimesh y pyrender NO suelen tener clave rosdep; instálalos con pip
       (ver README_LINEMOD.md). Se declaran como pip para documentar la
       dependencia. -->
  <exec_depend>python3-yaml</exec_depend>
  <!-- pip: trimesh pyrender  (renderer offline, solo entrenamiento) -->

  <!-- ICP (icp_pose_estimator_node): estimación de pose 6D YOLO + ICP.
       Open3D no tiene clave rosdep; instálalo con pip (ver README_ICP.md):
         pip3 install open3d
       sensor_msgs_py se usa de forma opcional; el nodo trae su propio
       parser de PointCloud2, por lo que no es estrictamente necesario. -->
  <!-- pip: open3d  (registro ICP y procesado de nubes de puntos) -->

  <!-- Generador de dataset sintético v2 (synthetic_dataset_generator_v2.py):
       reutiliza open3d (raycasting de visibilidad y rocas procedurales; sin
       trimesh a propósito). matplotlib solo lo usa dataset_stats.py y es
       opcional (cae a histogramas de texto si falta). -->
  <exec_depend>python3-matplotlib</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
