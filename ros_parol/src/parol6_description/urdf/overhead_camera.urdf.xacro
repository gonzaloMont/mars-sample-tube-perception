<?xml version="1.0"?>
<!--
  Overhead camera – modelo Gazebo independiente del robot PAROL6.

  Se spawnea como entidad separada en Gazebo con su propio robot_description.
  La TF world → overhead_camera_link se publica con un static_transform_publisher
  en el launch, exactamente igual que en el robot físico (donde la pose
  proviene de calibración extrínseca).

  Topics publicados:
    /overhead_camera/image_raw      (sensor_msgs/Image)
    /overhead_camera/camera_info    (sensor_msgs/CameraInfo)
  Frames TF:
    overhead_camera_link            (convención Gazebo)
    overhead_camera_optical_frame   (convención óptica ROS: Z fwd, X right, Y down)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="overhead_camera">

    <!-- Modelo estático: no se mueve por gravedad ni colisiones -->
    <gazebo>
        <static>true</static>
    </gazebo>

    <link name="overhead_camera_link">
        <inertial>
            <mass value="0.1"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1e-6" ixy="0" ixz="0"
                     iyy="1e-6" iyz="0" izz="1e-6"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.04 0.04 0.02"/>
            </geometry>
            <material name="camera_body">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.04 0.04 0.02"/>
            </geometry>
        </collision>
    </link>

    <!-- Optical frame: convención ROS (Z forward, X right, Y down)
         Necesario para cv_bridge, image_geometry, ArUco, etc. -->
    <link name="overhead_camera_optical_frame"/>

    <joint name="overhead_camera_optical_joint" type="fixed">
        <parent link="overhead_camera_link"/>
        <child link="overhead_camera_optical_frame"/>
        <origin xyz="0 0 0" rpy="-1.5707963267949 0 -1.5707963267949"/>
    </joint>

    <!-- Gazebo: sensor de cámara + plugin ROS 2 -->
    <gazebo reference="overhead_camera_link">
        <sensor type="camera" name="overhead_camera">
            <always_on>true</always_on>
            <update_rate>5.0</update_rate>
            <visualize>false</visualize>
            <camera name="overhead_cam">
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>10.0</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
            </camera>
            <plugin name="overhead_camera_controller" filename="libgazebo_ros_camera.so">
                <ros>
                    <namespace>overhead_camera</namespace>
                    <remapping>image_raw:=image_raw</remapping>
                    <remapping>camera_info:=camera_info</remapping>
                </ros>
                <camera_name>overhead_cam</camera_name>
                <frame_name>overhead_camera_optical_frame</frame_name>
                <hack_baseline>0.0</hack_baseline>
            </plugin>
        </sensor>
        <material>Gazebo/DarkGrey</material>
    </gazebo>

</robot>
