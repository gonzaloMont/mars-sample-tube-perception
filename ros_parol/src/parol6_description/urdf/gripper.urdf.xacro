<?xml version="1.0"?>
<!--
  Parallel gripper for PAROL6 con SENSORES DE CONTACTO
  Versión para Gazebo Classic con detección de agarre
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="gripper">

  <!-- ══════════ Gripper base (fijo a L6_link) ══════════ -->
  <link name="gripper_base_link">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 -0.0075" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0"
               iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.0075" rpy="0 0 0"/>
      <geometry><box size="0.035 0.025 0.015"/></geometry>
      <material name="gripper_dark">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0075" rpy="0 0 0"/>
      <geometry><box size="0.035 0.025 0.015"/></geometry>
    </collision>
  </link>

  <joint name="gripper_base_joint" type="fixed">
    <parent link="L6_link"/>
    <child  link="gripper_base_link"/>
    <origin xyz="0.025 0 -0.065" rpy="0 -1.5708 0"/>
  </joint>

  <!-- ══════════ Dedo izquierdo ══════════ -->
  <link name="left_finger_link">
    <inertial>
      <mass value="0.015"/>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <inertia ixx="1e-7" ixy="0" ixz="0"
               iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry><box size="0.015 0.005 0.04"/></geometry>
      <material name="gripper_finger">
        <color rgba="0.6 0.6 0.6 1"/>
      </material>
    </visual>
    <collision name="left_finger_collision">
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry><box size="0.015 0.005 0.04"/></geometry>
    </collision>
  </link>

  <joint name="gripper_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child  link="left_finger_link"/>
    <origin xyz="0 0.0025 -0.015" rpy="0 0 0"/>
    <axis   xyz="0 1 0"/>
    <limit  lower="-0.002" upper="0.027" effort="50" velocity="0.1"/>
  </joint>

  <!-- ══════════ Dedo derecho ══════════ -->
  <link name="right_finger_link">
    <inertial>
      <mass value="0.015"/>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <inertia ixx="1e-7" ixy="0" ixz="0"
               iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry><box size="0.015 0.005 0.04"/></geometry>
      <material name="gripper_finger">
        <color rgba="0.6 0.6 0.6 1"/>
      </material>
    </visual>
    <collision name="right_finger_collision">
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry><box size="0.015 0.005 0.04"/></geometry>
    </collision>
  </link>

  <joint name="gripper_right_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child  link="right_finger_link"/>
    <origin xyz="0 -0.0025 -0.015" rpy="0 0 0"/>
    <axis   xyz="0 -1 0"/>
    <limit  lower="-0.002" upper="0.027" effort="50" velocity="0.1"/>
  </joint>

  <!-- ══════════ Gazebo visual materials & friction ══════════ -->
  <gazebo reference="gripper_base_link">
    <material>Gazebo/DarkGrey</material>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="left_finger_link">
    <material>Gazebo/Grey</material>
    <selfCollide>false</selfCollide>
    <mu1>200</mu1>
    <mu2>200</mu2>
    <kp>10000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.01</maxVel>
  </gazebo>

  <gazebo reference="right_finger_link">
    <material>Gazebo/Grey</material>
    <selfCollide>false</selfCollide>
    <mu1>200</mu1>
    <mu2>200</mu2>
    <kp>10000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.01</maxVel>
  </gazebo>

  <!-- ══════════ SENSORES DE CONTACTO ══════════ -->
  <gazebo reference="left_finger_link">
    <sensor name="left_finger_contact" type="contact">
      <update_rate>100</update_rate>
      <always_on>true</always_on> 
      <contact>
        <collision>left_finger_link_fixed_joint_lump__left_finger_collision_collision</collision>
      </contact>
      
      <plugin name="left_finger_contact_plugin" filename="libgazebo_ros_bumper.so">
        <ros>
          <remapping>bumper_states:=/left_finger_contact</remapping>
        </ros>
        <frame_name>left_finger_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="right_finger_link">
    <sensor name="right_finger_contact" type="contact">
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <contact>
        <collision>right_finger_link_fixed_joint_lump__right_finger_collision_collision</collision>
      </contact>
      
      <plugin name="right_finger_contact_plugin" filename="libgazebo_ros_bumper.so">
        <ros>
          <remapping>bumper_states:=/right_finger_contact</remapping>
        </ros>
        <frame_name>right_finger_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  
</robot>
