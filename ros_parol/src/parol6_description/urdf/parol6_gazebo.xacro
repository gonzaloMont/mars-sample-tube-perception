<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="parol6">

    <!-- Import original PAROL6 URDF -->
    <xacro:include filename="$(find parol6_description)/urdf/parol6.urdf" />

    <!-- Import parallel gripper -->
    <xacro:include filename="$(find parol6_description)/urdf/gripper.urdf.xacro" />

    <!-- ros2_control hardware interface for Gazebo simulation -->
    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>
        <joint name="L1">
            <command_interface name="position">
                <param name="min">-1.7</param>
                <param name="max">1.7</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="L2">
            <command_interface name="position">
                <param name="min">-0.98</param>
                <param name="max">1.0</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">-0.9599771561327288</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="L3">
            <command_interface name="position">
                <param name="min">-2.0</param>
                <param name="max">1.3</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">1.28999018740207</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="L4">
            <command_interface name="position">
                <param name="min">-2.0</param>
                <param name="max">2.0</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="L5">
            <command_interface name="position">
                <param name="min">-2.1</param>
                <param name="max">2.1</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.2581663987092836</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="L6">
            <command_interface name="position">
                <param name="min">-3.1</param>
                <param name="max">3.1</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.017957190239044962</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="gripper_joint">
            <command_interface name="position">
                <param name="min">0.0</param>
                <param name="max">0.025</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.025</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="gripper_right_joint">
            <command_interface name="position">
                <param name="min">0.0</param>
                <param name="max">0.025</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.025</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>

    <!-- Gazebo ros2_control plugin -->
    <gazebo>
        <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
            <parameters>$(find parol6_gazebo)/config/gazebo_controllers.yaml</parameters>
        </plugin>
    </gazebo>

</robot>
